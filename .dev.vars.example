# Copy to .dev.vars and paste your own values after the = sign.
# .dev.vars is ignored by git and must never be committed.

# Meta Model API key (Muse Spark and SAM 3.1). Needed for the web app and for WhatsApp.
MODEL_API_KEY=

# WhatsApp channel only (see "Run WhatsApp with your own test number" in README.md).
# Access token from your Meta app: WhatsApp > API Setup, or a system user token.
WHATSAPP_TOKEN=
# App secret from your Meta app: App settings > Basic. Used to check X-Hub-Signature-256.
WHATSAPP_APP_SECRET=
# Any long random string you choose; type the same one in WhatsApp > Configuration.
WHATSAPP_VERIFY_TOKEN=
